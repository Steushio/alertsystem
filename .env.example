# Upstash Redis / Vercel KV environment variables:
# (If using Upstash Redis from Vercel Marketplace, these are named UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Or legacy Vercel KV:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# NextAuth configuration (REQUIRED on Vercel production):
NEXTAUTH_SECRET=your-secret-key-at-least-32-chars
NEXTAUTH_URL=https://your-alertsystem-domain.vercel.app

# Vercel Blob (for uploading custom GIFs/sounds in the dashboard):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
